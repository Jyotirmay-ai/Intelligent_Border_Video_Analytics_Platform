{
  "extends": "./dashboard/tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./dashboard/src/*"],
      "@modules/*": ["./modules/*"]
    }
  },
  "include": [
    "dashboard/**/*.ts",
    "dashboard/**/*.tsx",
    "dashboard/**/*.mts",
    "dashboard/next-env.d.ts",
    "dashboard/.next/types/**/*.ts",
    "dashboard/.next/dev/types/**/*.ts",
    "modules/**/*.ts",
    "modules/**/*.tsx"
  ],
  "exclude": ["**/node_modules"]
}
